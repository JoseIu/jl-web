---
import ChatIcon from "../assets/icons/chatIcon.svg";
import Button from "../components/button/Button.astro";
import HeroWeb from "../components/hero-web/HeroWeb.astro";
---

<section class="hero wrapper" id="hero">
  <div class="hero__container">
    <h1 class="hero__title">
      Tu página web profesional, <span class="hero__title-price"
        >desde 400&euro;.</span
      >
    </h1>
    <p class="hero__subtitle">
      Creamos webs rápidas, bonitas y pensadas para conseguir clientes. Sin
      permanencias raras ni presupuestos hinchados. Te respondemos hoy mismo por
      WhatsApp.
    </p>
    <div class="hero__actions">
      <Button
        variant="primary"
        size="lg"
        href="https://wa.me/34600000000"
        blank={true}
      >
        <ChatIcon slot="icon" class="button__icon" />
        Pídenos presupuesto gratis
      </Button>
      <Button variant="outline" size="lg" href="#pricing">Ver precios</Button>
    </div>
  </div>
  <div>
    <HeroWeb />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 8rem 1rem 4rem;

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 4rem 1rem;
    }
  }

  .hero__title {
    font-family: var(--font-headline);
    font-size: clamp(2.25rem, 5vw, 5.5rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    color: var(--secondary);
  }
  .hero__title-price {
    color: var(--tertiary);
    border-bottom: 4px solid var(--border-color);
  }

  .hero__subtitle {
    font-size: 1.125rem;
    color: var(--tertiary-light);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 36rem;
    @media (max-width: 768px) {
      max-width: none;
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
    @media (max-width: 768px) {
      justify-content: center;
    }
  }
</style>
