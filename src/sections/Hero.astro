---
import Button from "../components/button/Button.astro";
---

<section class="hero" id="hero">
  <div class="hero__container container">
    <h1 class="hero__title">
      Tu p&aacute;gina web profesional, desde 300&euro;.
    </h1>
    <p class="hero__subtitle">
      Creamos webs r&aacute;pidas, bonitas y pensadas para conseguir clientes.
      Sin permanencias raras ni presupuestos hinchados. Te respondemos hoy mismo
      por WhatsApp.
    </p>
    <div class="hero__actions">
      <Button
        variant="primary"
        size="lg"
        href="https://wa.me/34600000000"
        blank={true}>Pedir presupuesto</Button
      >
      <Button variant="outline" size="lg" href="#pricing">Ver precios</Button>
    </div>
    <div class="hero__features">
      <div class="hero__feature">
        <span class="hero__feature-icon">&#9889;</span>
        <span class="hero__feature-text"
          >R&aacute;pida<small>carga veloz</small></span
        >
      </div>
      <div class="hero__feature">
        <span class="hero__feature-icon">&#128241;</span>
        <span class="hero__feature-text"
          >M&oacute;vil<small>se ve perfecta</small></span
        >
      </div>
      <div class="hero__feature">
        <span class="hero__feature-icon">&#128269;</span>
        <span class="hero__feature-text"
          >Google<small>te encuentran</small></span
        >
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 8rem 0 4rem;
    background: linear-gradient(135deg, var(--neutral) 0%, #fff 100%);
  }

  .hero__title {
    font-family: var(--font-headline);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    color: var(--secondary);
  }

  .hero__subtitle {
    font-size: 1.125rem;
    color: var(--tertiary);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 36rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .hero__features {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .hero__feature {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero__feature-icon {
    font-size: 1.5rem;
  }

  .hero__feature-text {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.9375rem;
    display: flex;
    flex-direction: column;
  }

  .hero__feature-text small {
    font-weight: 400;
    color: var(--tertiary);
    font-size: 0.8125rem;
  }

  @media (min-width: 768px) {
    .hero__title {
      font-size: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding: 10rem 0 6rem;
    }

    .hero__title {
      font-size: 3.75rem;
    }
  }
</style>
