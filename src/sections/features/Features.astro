---
import "./styles.css";

import CalendarIcon from "../../assets/icons/calendarIcon.svg";
import CheckIcon from "../../assets/icons/checkIcon.svg";
import PriceIcon from "../../assets/icons/priceIcon.svg";
import SpeedIcon from "../../assets/icons/speedIcon.svg";
---

<section class="features">
  <div class="features__container wrapper">
    <div class="features__track">
      <article class="features__card">
        <CheckIcon class="features__card-icon" />
        <h3 class="features__card-title">Diseño 100% a medida</h3>
      </article>
      <article class="features__card">
        <SpeedIcon class="features__card-icon" />
        <h3 class="features__card-title">Respuesta Rápida</h3>
      </article>
      <article class="features__card">
        <PriceIcon class="features__card-icon" />
        <h3 class="features__card-title">Precio cerrado por escrito</h3>
      </article>
      <article class="features__card">
        <CalendarIcon class="features__card-icon" />
        <h3 class="features__card-title">Pago hasta en 3 plazos</h3>
      </article>
    </div>
  </div>
</section>
