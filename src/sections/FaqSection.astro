---
import Faq from '../components/faq/Faq.astro';
---

<section class="faq-section" id="faq">
  <div class="faq-section__container container">
    <h2 class="faq-section__title">Lo que m&aacute;s nos preguntan.</h2>
    <Faq />
  </div>
</section>

<style>
  .faq-section {
    padding: 4rem 0;
    background-color: var(--neutral);
  }

  .faq-section__title {
    font-family: var(--font-headline);
    font-size: 1.875rem;
    font-weight: 800;
    text-align: center;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .faq-section__title {
      font-size: 2.25rem;
    }
  }
</style>
