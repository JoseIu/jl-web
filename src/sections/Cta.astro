---
import Form from "../components/form/Form.astro";
---

<section class="cta" id="contact">
  <div class="cta__container wrapper">
    <div>
      <h2 class="cta__title">
        Cuéntanos tu idea. Te decimos precio y plazo hoy mismo.
      </h2>
      <p class="cta__subtitle">
        Sin formularios eternos. Escríbenos por WhatsApp y hablamos como
        personas, sin tecnicismos ni compromiso.
      </p>
      <div class="cta__actions">
        <!-- <Button
          variant="primary"
          size="lg"
          href="https://wa.me/34600000000"
          blank={true}
        >
          Escríbenos por WhatsApp
        </Button> -->
      </div>
    </div>
    <div>
      <h2 class="cta__title">Envíanos un mensaje</h2>
      <Form />
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 6rem 0;

    margin-bottom: 3rem;
  }
  .cta__container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 3rem;
    /* background-color: var(--primary); */
    color: var(--primary-inverted);
    border-radius: 0.7rem;
  }

  .cta__title {
    color: var(--primary);

    font-family: var(--font-headline);
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .cta__subtitle {
    font-size: 1.0625rem;
    color: #9ca3af;
    margin-bottom: 2rem;
    max-width: 36rem;

    line-height: 1.7;
  }

  .cta__actions {
    display: flex;
    justify-content: center;
  }
</style>
