---
import "./styles.css";
---

<form class="form">
  <input
    class="form__input"
    type="text"
    name="nombre"
    placeholder="Nombre"
    required
  />
  <input
    class="form__input"
    type="email"
    name="email"
    placeholder="Email"
    required
  />

  <textarea class="form__area" name="" id="" placeholder="Asunto"></textarea>
  <button class="form__submit" type="submit">Enviar</button>
</form>
