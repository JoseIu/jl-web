---
import "./styles.css";
export interface Props {
  variant?: "primary" | "secondary" | "outline";
  href?: string;
  size?: "sm" | "md" | "lg";
  blank?: boolean;
  iCon?: string;
}

const { variant = "primary", href, size = "md", blank = false } = Astro.props;

const classes = `button button--${variant} button--${size}`;
---

{
  href ? (
    <a
      href={href}
      class={classes}
      target={blank ? "_blank" : undefined}
      rel={blank ? "noopener noreferrer" : undefined}
    >
      <slot name="icon" />
      <slot />
      <slot name="icon-r" />
    </a>
  ) : (
    <button class={classes}>
      <slot name="icon" />
      <slot />
    </button>
  )
}
