---
import "./styles.css";
---

<footer class="footer">
  <div class="footer__container container">
    <div class="footer__brand">
      <a href="#" class="footer__logo">Surgelabs</a>
      <p class="footer__description">
        Soluciones web de alto rendimiento para negocios que buscan crecer de
        verdad. Especializados en el sur de España.
      </p>
    </div>
    <div class="footer__nav">
      <h4 class="footer__nav-title">Enlaces</h4>
      <ul class="footer__nav-list">
        <li class="footer__nav-item">
          <a href="#services" class="footer__nav-link">Servicios</a>
        </li>
        <li class="footer__nav-item">
          <a href="#pricing" class="footer__nav-link">Precios</a>
        </li>
        <li class="footer__nav-item">
          <a href="#portfolio" class="footer__nav-link">Portafolio</a>
        </li>
        <li class="footer__nav-item">
          <a href="#contact" class="footer__nav-link">Contacto</a>
        </li>
      </ul>
    </div>
    <div class="footer__legal">
      <h4 class="footer__legal-title">Legal</h4>
      <ul class="footer__legal-list">
        <li class="footer__legal-item">
          <a href="#" class="footer__legal-link">Privacy Policy</a>
        </li>
        <li class="footer__legal-item">
          <a href="#" class="footer__legal-link">Terms of Service</a>
        </li>
        <li class="footer__legal-item">
          <a
            href="https://wa.me/34600000000"
            class="footer__legal-link"
            target="_blank">WhatsApp Support</a>
        </li>
        <li class="footer__legal-item">
          <a href="#" class="footer__legal-link">LinkedIn</a>
        </li>
      </ul>
    </div>
    <div class="footer__copyright">
      <p>© 2024 Surgelabs. High-performance web solutions.</p>
    </div>
  </div>
</footer>
